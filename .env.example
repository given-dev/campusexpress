APP_ENV=production
APP_KEY=replace-with-at-least-32-random-characters
APP_SHOW_OTP=0
DB_HOST=your-database-host
DB_NAME=campusexpress
DB_USER=your-database-user
DB_PASS=your-strong-database-password
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=login@your-verified-domain.com
# Google OAuth web client (leave blank until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/campusexpress/google_callback.php
